{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nara-vite-react-boilerplate",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "local-db-name",
      "database_id": "local-db-id",
      "migrations_dir": "drizzle",
    },
  ],
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "D1_DATABASE_NAME",
          "database_id": "D1_DATABASE_ID",
          "migrations_dir": "drizzle",
        },
      ],
      "routes": [
        {
          "pattern": "CLOUDFLARE_PROD_DOMAIN",
          "custom_domain": true,
        },
      ],
    },
    "development": {
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "D1_DATABASE_NAME",
          "database_id": "D1_DATABASE_ID",
          "migrations_dir": "drizzle",
        },
      ],
      "routes": [
        {
          "pattern": "CLOUDFLARE_DEV_DOMAIN",
          "custom_domain": true,
        },
      ],
    },
  },
}
