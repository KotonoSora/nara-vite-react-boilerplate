{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nara-vite-react-boilerplate",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat_v2"],
  "main": "./workers/app.ts",
  "secrets": {
    "required": [
      "D1_DATABASE_ID",
      "D1_DATABASE_NAME",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN",
    ],
  },
  "vars": {
    "VITE_CONTACT_EMAIL": "$VITE_CONTACT_EMAIL",
    "VITE_DEV_DOMAIN": "$VITE_DEV_DOMAIN",
    "VITE_DONATE_LINK": "$VITE_DONATE_LINK",
    "VITE_GOOGLE_ANALYTIC_TRACKING_ID": "$VITE_GOOGLE_ANALYTIC_TRACKING_ID",
    "VITE_LANDING_PAGE_COMMERCIAL_LINK": "$VITE_LANDING_PAGE_COMMERCIAL_LINK",
    "VITE_LANDING_PAGE_DESCRIPTION": "$VITE_LANDING_PAGE_DESCRIPTION",
    "VITE_LANDING_PAGE_REPOSITORY": "$VITE_LANDING_PAGE_REPOSITORY",
    "VITE_LANDING_PAGE_TITLE": "$VITE_LANDING_PAGE_TITLE",
    "VITE_MAX_USERS": "$VITE_MAX_USERS",
    "VITE_PROD_DOMAIN": "$VITE_PROD_DOMAIN",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "$D1_DATABASE_NAME",
      "database_id": "$D1_DATABASE_ID",
      "migrations_dir": "drizzle",
    },
  ],
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "$CLOUDFLARE_PROD_DOMAIN",
          "custom_domain": true,
        },
      ],
    },
    "development": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "$CLOUDFLARE_DEV_DOMAIN",
          "custom_domain": true,
        },
      ],
      "secrets": {
        "required": ["BASIC_AUTH_PASSWORD", "BASIC_AUTH_USERNAME"],
      },
    },
  },
}
